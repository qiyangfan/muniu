{
  "provider": "openai",
  "scenario": "stream-basic",
  "source_url": "https://platform.openai.com/docs/api-reference/chat/streaming",
  "inbound": {
    "model": "gpt-4o-mini",
    "stream": true,
    "stream_options": { "include_usage": true },
    "messages": [{ "role": "user", "content": "你好" }]
  },
  "upstream_raw": {
    "stream": [
      "{\"id\":\"chatcmpl-s1\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"\"},\"finish_reason\":null}]}",
      "{\"id\":\"chatcmpl-s1\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"你好\"},\"finish_reason\":null}]}",
      "{\"id\":\"chatcmpl-s1\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"!\"},\"finish_reason\":null}]}",
      "{\"id\":\"chatcmpl-s1\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}]}",
      "{\"id\":\"chatcmpl-s1\",\"object\":\"chat.completion.chunk\",\"choices\":[],\"usage\":{\"prompt_tokens\":11,\"completion_tokens\":3,\"total_tokens\":14,\"prompt_tokens_details\":{\"cached_tokens\":4},\"completion_tokens_details\":{\"reasoning_tokens\":0}}}",
      "[DONE]"
    ]
  },
  "expect": {
    "usage": {
      "prompt_tokens": 11,
      "completion_tokens": 3,
      "reasoning_tokens": 0,
      "cached_tokens": 4
    },
    "events": [
      { "has_content": false, "is_usage": false, "is_done": false },
      { "has_content": true, "is_usage": false, "is_done": false },
      { "has_content": true, "is_usage": false, "is_done": false },
      { "has_content": false, "is_usage": false, "is_done": false },
      { "has_content": false, "is_usage": true, "is_done": false },
      { "has_content": false, "is_usage": false, "is_done": true }
    ]
  }
}
