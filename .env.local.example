# muniu 本机常驻服务环境变量(podman --env-file 注入;.env.* 已 gitignore,真值勿入库)
# 上游 key:muniu.yaml providers.keys 以 env 变量名引用,真值只在此处与进程环境
DASHSCOPE_API_KEY=
# 本机冒烟上游 ollama(127.0.0.1:11434)不校验 key,占位即可
OLLAMA_SMOKE_KEY=ollama-local
# 管理面 token(管理 API 与控制台门禁;本地 dev 惯例明文,仅本机)
MUNIU_ADMIN_TOKEN=muniu-dev-admin-token
