{
  "provider": "responses-inbound",
  "scenario": "request-translation",
  "source_url": "docs/design/proxy-and-streaming.md「Responses 入站翻译」;docs/design/adr/0012-responses-api-inbound.md",
  "inbound": {
    "model": "alias-a",
    "instructions": "be nice",
    "input": [
      {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "hi"}]},
      {"type": "function_call", "call_id": "c1", "name": "get_weather", "arguments": "{\"city\":\"杭州\"}"},
      {"type": "function_call_output", "call_id": "c1", "output": "晴"}
    ],
    "tools": [{"type": "function", "name": "get_weather", "description": "查天气", "parameters": {"type": "object", "properties": {}}}],
    "tool_choice": "auto",
    "max_output_tokens": 64,
    "temperature": 0.2,
    "stream": false
  },
  "expect": {
    "canonical_chat": {
      "messages": [
        {"role": "system", "content": "be nice"},
        {"role": "user", "content": "hi"},
        {"role": "assistant", "content": null, "tool_calls": [{"id": "c1", "type": "function", "function": {"name": "get_weather", "arguments": "{\"city\":\"杭州\"}"}}]},
        {"role": "tool", "tool_call_id": "c1", "content": "晴"}
      ],
      "tools": [{"type": "function", "function": {"name": "get_weather", "description": "查天气", "parameters": {"properties": {}, "type": "object"}}}],
      "tool_choice": "auto",
      "max_tokens": 64,
      "temperature": 0.2
    },
    "absent": ["instructions", "max_output_tokens", "previous_response_id", "store", "metadata"]
  }
}
